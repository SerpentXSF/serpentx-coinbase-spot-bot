# Coinbase Advanced Trade API credentials
# Create a Secret API key at https://portal.cdp.coinbase.com/ (Coinbase Developer Platform).
# Choose the ECDSA signature algorithm (this bot reads PEM keys; Coinbase's
# Ed25519 keys are issued in a non-PEM format).
# Grant View (and Trade only if you will go live). Do NOT enable Transfer/withdrawal.
#
# Leave these blank to run in public, read-only mode (market analysis only).
# Format when filled in:
#   COINBASE_API_KEY_NAME=organizations/<org-id>/apiKeys/<key-id>
#   COINBASE_API_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
# Keep the private key on ONE line, wrapped in double quotes, with each real
# newline written as \n.
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=

# Required live-trading gate. Keep 0 until you intentionally go live.
COINBASE_TRADING_ENABLED=0

# Optional external context providers. Leave blank if unused.
HELIUS_API_KEY=
HELIUS_RPC_URL=
ALCHEMY_SOLANA_RPC_URL=
ALCHEMY_SOLANA_WSS_URL=
QUICKNODE_SOLANA_RPC_URL=
UNUSUAL_WHALES_API_KEY=
COINGECKO_API_KEY=

# Optional push alerts for real orders, the daily loss limit, config errors,
# and crashed runs. Paste a Discord/Slack incoming-webhook URL or an ntfy topic
# URL (e.g. https://ntfy.sh/your-secret-topic). Leave blank to disable.
ALERT_WEBHOOK_URL=
# Optional: force the payload format (discord | slack | ntfy | json). Needed for
# self-hosted ntfy servers; discord.com, hooks.slack.com and ntfy.sh are detected.
ALERT_WEBHOOK_FORMAT=
