# Coinbase Advanced Trade API credentials
# Create at https://www.coinbase.com/settings/api or Coinbase Developer Platform.
# Do NOT enable withdrawal/transfer permissions.
COINBASE_API_KEY_NAME=organizations/YOUR_ORG_ID/apiKeys/YOUR_KEY_ID
COINBASE_API_PRIVATE_KEY="PASTE_YOUR_COINBASE_PEM_PRIVATE_KEY_WITH_ESCAPED_NEWLINES"

# Required live-trading gate. Keep 0 until you intentionally go live.
COINBASE_TRADING_ENABLED=0

# Optional external context providers. Leave blank if unused.
HELIUS_API_KEY=
HELIUS_RPC_URL=
UNUSUAL_WHALES_API_KEY=
